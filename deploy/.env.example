# SecureTalk deployment environment — TEMPLATE ONLY.
# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core application secrets ---
# Flask/Django-style app secret; used to sign sessions/tokens. MUST be changed.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE

# --- Database ---
POSTGRES_USER=securetalk
POSTGRES_DB=securetalk
# Generate a strong unique password per environment. NEVER use the placeholder.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Composed automatically in docker-compose.yml; override only if connecting
# from outside the compose network:
# DATABASE_URL=postgresql+psycopg://securetalk:${POSTGRES_PASSWORD}@postgres:5432/securetalk

# --- Redis ---
# Ephemeral state only (presence, floor control, rate limits). No persistence
# of voice/media data — see comment in docker-compose.yml.
REDIS_URL=redis://redis:6379/0

# --- Admin / health details endpoint (admin-gated per ARCHITECTURE §10) ---
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# --- CORS / origins ---
ALLOWED_ORIGINS=https://securetalk.example.com

# --- TLS (paths relative to deploy/; see deploy/README.md) ---
# certs/ contains fullchain.pem + privkey.pem (self-signed or certbot)
# TLS_DOMAIN=securetalk.example.com

# --- Logging ---
LOG_LEVEL=INFO
